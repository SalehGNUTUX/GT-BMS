<?xml version="1.0" encoding="utf-8"?>
<!-- GT-BMS battery screen: header + tabs (Live / Cells / Info / History). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_battery"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_conn_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/st_disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_bms_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:tabMode="auto"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/accent_blue"
        app:tabIndicatorFullWidth="true"
        app:tabSelectedTextColor="@color/accent_blue"
        app:tabTextColor="@color/text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ═════════ LIVE ═════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_waiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/waiting_data"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/live_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <!-- Active charge / trip / discharge banner (+ manual "End trip") -->
                <LinearLayout
                    android:id="@+id/box_session_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_session_banner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_trip"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/end_trip"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Hero: gauge + SOC -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.vanaccess.bms.ui.battery.BatteryGaugeView
                            android:id="@+id/gauge"
                            android:layout_width="78dp"
                            android:layout_height="132dp"
                            android:layout_marginEnd="18dp" />

                        <!-- "Ring" design gauge (hidden in the other designs) -->
                        <com.vanaccess.bms.ui.battery.RingGaugeView
                            android:id="@+id/ring"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_marginEnd="14dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_soc_label"
                                style="@style/GtMetricLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_soc" />

                            <TextView
                                android:id="@+id/tv_soc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--%"
                                android:textColor="@color/text_primary"
                                android:textSize="52sp"
                                android:textStyle="bold"
                                android:fontFeatureSettings="tnum" />

                            <TextView
                                android:id="@+id/tv_state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_time_left"
                                style="@style/GtMetricLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2x2 metric tiles, filled in code -->
                <GridLayout
                    android:id="@+id/grid_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="false"
                    android:layout_marginBottom="4dp" />

                <!-- Capacity -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/box_capacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lbl_capacity" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_capacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:trackThickness="8dp"
                            app:trackCornerRadius="4dp"
                            app:trackColor="#1AFFFFFF" />
                        <LinearLayout android:id="@+id/rows_capacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Temperatures -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/temperatures" />
                        <GridLayout android:id="@+id/grid_temps" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MOS / balance / heating -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lbl_bms_status" />
                        <GridLayout android:id="@+id/grid_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recommendations (Advisor) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adv_title" />
                        <LinearLayout android:id="@+id/box_recs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Alerts -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lbl_protection_alerts" />
                        <LinearLayout android:id="@+id/box_alerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═════════ CELLS ═════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_cells"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <GridLayout
                    android:id="@+id/grid_cell_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cells_title" style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lbl_cell_voltages" />
                        <TextView style="@style/GtMetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/cells_legend" />
                        <GridLayout android:id="@+id/grid_cells" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cells_deviation" />
                        <TextView style="@style/GtMetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="@string/cells_deviation_desc" />
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chart_cells"
                            android:layout_width="match_parent"
                            android:layout_height="200dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cells over time (weak-cell tracking) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/GtCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/GtCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cell_trend_title" />
                        <TextView style="@style/GtMetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="@string/cell_trend_desc" />
                        <LinearLayout android:id="@+id/box_cell_trend" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ═════════ REPORTS ═════════ -->
        <LinearLayout
            android:id="@+id/page_reports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_reports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:singleSelection="true"
                app:selectionRequired="true" />

            <TextView
                android:id="@+id/tv_reports_empty"
                style="@style/GtMetricLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/rep_empty"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_levels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/box_levels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp" />
            </androidx.core.widget.NestedScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_reports"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- ═════════ INFO ═════════ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/box_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </androidx.core.widget.NestedScrollView>

        <!-- ═════════ HISTORY ═════════ -->
        <LinearLayout
            android:id="@+id/page_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/tv_history_status"
                    style="@style/GtMetricLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/history_hint" />
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:indicatorSize="22dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_history"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_load" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
