<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@null"
        app:itemBackground="@drawable/nav_item_bg"
        app:itemRippleColor="#332196F3"
        app:itemPaddingTop="12dp"
        app:itemPaddingBottom="12dp"
        app:itemTextAppearanceActive="@style/NavLabelActive"
        app:itemTextAppearanceInactive="@style/NavLabel"
        android:background="@color/surface_dark"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Central Live button (raised over the bar's empty middle slot) -->
    <ImageButton
        android:id="@+id/btn_live"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/live_fab_bg"
        android:contentDescription="@string/tab_live"
        android:elevation="12dp"
        android:scaleType="center"
        android:src="@drawable/ic_bolt"
        app:tint="#2196F3" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
