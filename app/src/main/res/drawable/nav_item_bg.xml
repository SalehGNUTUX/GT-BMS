<?xml version="1.0" encoding="utf-8"?>
<!-- Selected bottom-nav tab: a rounded tile covering the whole item (icon + label). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#262196F3" />
                <stroke android:width="1dp" android:color="#662196F3" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
